EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional. Route data API calls through the Tempo API gateway (gateway/), which
# verifies the JWT, allowlists RPCs and rate-limits. Leave empty to call Supabase directly.
EXPO_PUBLIC_API_GATEWAY_URL=
# Google OAuth credentials belong in Supabase Auth, never in EXPO_PUBLIC_*.
