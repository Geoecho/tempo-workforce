{
  "expo": {
    "name": "Tempo",
    "slug": "tempo-workforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tempo",
    "icon": "./assets/tempo-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netaville.tempo.workforce"
    },
    "android": {
      "package": "com.netaville.tempo.workforce",
      "adaptiveIcon": {
        "backgroundColor": "#254E3D",
        "foregroundImage": "./assets/tempo-adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tempo to scan site check-in codes."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#254E3D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tempo to set a precise site meeting point when you choose your current location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tempo to choose a team member profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Tempo to prepare your shifts in your calendar."
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F8F9F5",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-system-ui",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.netaville.tempo.workforce.watch",
                  "targetName": "watch"
                }
              ]
            }
          }
        },
        "projectId": "e69d4acb-145e-4be5-8f8b-ba35a599adc9"
      }
    },
    "owner": "geoecho1999"
  }
}
