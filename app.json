{
  "expo": {
    "name": "Tempo",
    "slug": "tempo-workforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tempo",
    "icon": "./assets/tempo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netaville.tempo.workforce"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#254E3D",
        "foregroundImage": "./assets/tempo-adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tempo to scan site check-in codes."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#254E3D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tempo to set a precise site meeting point when you choose your current location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tempo to choose a team member profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Tempo to prepare your shifts in your calendar."
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F8F9F5",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
