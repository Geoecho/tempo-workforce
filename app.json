{
  "expo": {
    "name": "Tempo",
    "slug": "tempo-workforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tempo",
    "icon": "./assets/tempo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netaville.tempo.workforce"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#164B3B",
        "foregroundImage": "./assets/tempo-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/tempo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tempo to scan site check-in codes."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tempo to choose a team member profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Tempo to prepare your shifts in your calendar."
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
